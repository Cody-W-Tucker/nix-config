{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "code-review-graph": {
      "type": "local",
      "command": [
        "code-review-graph",
        "serve",
        "--repo",
        "/etc/nixos"
      ],
      "environment": {
        "CRG_OPENAI_BASE_URL": "http://nas:8081/v1",
        "CRG_OPENAI_API_KEY": "llama-swap",
        "CRG_OPENAI_MODEL": "qwen3-embedding-0.6b",
        "CRG_OPENAI_BATCH_SIZE": "16",
        "CRG_ACCEPT_CLOUD_EMBEDDINGS": "1"
      }
    }
  }
}
