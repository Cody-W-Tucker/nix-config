+/// Executes a Lua dispatcher through `hyprctl eval`.
+///
+/// Hyprland's Lua config provider rejects the legacy `hyprctl dispatch` IPC
+/// syntax that hyprland-rs emits, so dispatchers are expressed with the
+/// `hl.dsp.*` Lua bindings instead. Both the exit status and the `ok` reply
+/// are checked, since `hyprctl eval` returns 0 even when a dispatcher fails.
+fn lua_dispatch(lua: &str) -> hyprland::Result<()> {
+    let output = std::process::Command::new("hyprctl").arg("eval").arg(lua).output()?;
+
+    let stdout = String::from_utf8_lossy(&output.stdout);
+
+    if output.status.success() && stdout.trim() == "ok" {
+        Ok(())
+    } else {
+        Err(HyprError::other(format!("hyprctl eval failed: {}", String::from_utf8_lossy(&output.stderr).trim())))
+    }
+}
+
